{
  "name": "pmpilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PMPilot (Associate PM) - Browser-Based Research Agent for Product Managers",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "concurrently --kill-others \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && node src/server.js",
    "start:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "copilotkit",
    "openai-agents-sdk",
    "exa",
    "redis",
    "trigger-dev",
    "mozilla-ai",
    "openrouter",
    "product-management"
  ],
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "Sairishita Manne",
  "license": "MIT"
}

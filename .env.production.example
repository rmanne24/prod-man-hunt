# ==============================================================================
# PMPilot Production Environment Variables Template
# Copy to backend/.env and replace placeholders with secure random secrets
# ==============================================================================

# Core Application Server
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://app.pmpilot.ai,https://pmpilot.ai

# Session Security & User Authentication (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=YOUR_64_CHAR_HEX_SESSION_SECRET_HERE

# Integration Data Protection (REQUIRED for OAuth token encryption)
# Must be exactly 32 bytes (64 hex characters) for AES-256-GCM authenticated encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=YOUR_64_CHAR_HEX_AES_256_GCM_ENCRYPTION_KEY_HERE

# Switch AI Collaboration Fabric (Sponsor Integration)
# Official documentation: https://docs.switchagents.ai
SWITCH_SERVER_URL=http://localhost:8000
SWITCH_REGISTRATION_TOKEN=YOUR_SWITCH_REGISTRATION_TOKEN_HERE
SWITCH_AGENT_API_KEY=YOUR_SWITCH_AGENT_API_KEY_HERE

# Linear Delivery Integration (OAuth 2.0 PKCE)
# Create application at: https://linear.app/settings/api/applications/new
# Redirect URI: https://app.pmpilot.ai/ (or http://localhost:5173/ in development)
LINEAR_CLIENT_ID=YOUR_LINEAR_CLIENT_ID
LINEAR_CLIENT_SECRET=YOUR_LINEAR_CLIENT_SECRET

# Enterprise SSO / Auth0 OIDC (Optional)
# If unconfigured, PMPilot safely defaults to local cryptographic PBKDF2 authentication
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# External Research Engines (Optional)
EXA_API_KEY=
TRIGGER_SECRET_KEY=


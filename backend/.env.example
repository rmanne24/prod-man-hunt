# PMPilot (Associate PM) Environment Variables
PORT=4000

# OpenAI & OpenRouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=

# Exa AI Competitor Search
EXA_API_KEY=

# Trigger.dev Background Jobs
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Redis Working Memory (leave empty to use resilient in-memory fallback)
REDIS_URL=

# Auth0 Identity
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Linear OAuth 2.0 Integration
# Register OAuth app at: https://linear.app/settings/api/applications/new
# Redirect URI: http://127.0.0.1:5173/ and http://localhost:5173/
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# AES-256-GCM Token Encryption Key (Strict requirement: exactly 32 bytes encoded as 64 hex characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# Switch AI Collaboration Integration
# Documentation: https://docs.switchagents.ai/switch-rooms/internals/agent-protocol
# GitHub: https://github.com/sandbox-quantum/switch
# Server URL for self-hosted or cloud Switch rooms (default: http://localhost:8000)
SWITCH_SERVER_URL=http://localhost:8000
# Switch Agent Registration Token (used for POST /agents)
SWITCH_REGISTRATION_TOKEN=
# Switch Agent API Key (returned by POST /agents or provided in dashboard)
SWITCH_AGENT_API_KEY=
# Switch Agent ID (default: ag_pmpilot_assistant)
SWITCH_AGENT_ID=ag_pmpilot_assistant
